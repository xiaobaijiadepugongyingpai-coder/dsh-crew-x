# .env.example - DSH Crew configuration template
# Copy to ~/.config/dsh-crew/.env (or .env for standalone development)

# DeepSeek API Key (required only for standalone/multimodal mode)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: DSH Hub loopback URL override (default: dynamic discovery via hub.json)
# DSHPLUGIN_CREW_HUB=http://127.0.0.1:3080

# Optional: Max permission ceiling (read-only | workspace-write | auto | full-access)
# DSH_CREW_MAX_PERMISSION=workspace-write
